# ---------------------------------------------------------------- secrets
# Never commit keys, passwords or signing material. See docs/runbooks/secrets.md.
.secrets/
*.env
.env*
env/*.local.json
**/android/local.properties
**/android/key.properties
*.jks
*.keystore

# ---------------------------------------------------------------- Dart / Flutter
.dart_tool/
build/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
# Test coverage output only (a bare "coverage/" also hid lib/features/coverage).
/coverage/
apps/*/coverage/
packages/*/coverage/
*.g.dart.tmp

# ---------------------------------------------------------------- Supabase CLI
supabase/.temp/
supabase/.branches/

# ---------------------------------------------------------------- tooling
node_modules/
tools/**/node_modules/

# ---------------------------------------------------------------- OS / editors
.DS_Store
Thumbs.db
*.iml
.idea/
*.swp

# Firebase config per app (kept out of the public repo; docs/runbooks/push-notifications.md)
**/android/app/google-services.json
/google-services.json
